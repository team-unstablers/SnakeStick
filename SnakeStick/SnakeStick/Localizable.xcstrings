    "Needed to boot with Secure Boot on PCs that have revoked the 2011 certificate. Only for Windows 11 25H2 or later ISOs." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Erforderlich, um auf PCs, die das Zertifikat von 2011 widerrufen haben, mit aktiviertem Secure Boot zu starten. Nur für ISOs von Windows 11 25H2 oder neuer." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Necesario para arrancar con Secure Boot activado en los PC que han revocado el certificado de 2011. Solo para ISO de Windows 11 25H2 o posterior." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Nécessaire pour démarrer avec Secure Boot activé sur les PC qui ont révoqué le certificat de 2011. Uniquement pour les ISO de Windows 11 25H2 ou ultérieure." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "2011 年の証明書を失効させた PC で、Secure Boot を有効にしたまま起動するために必要です。Windows 11 25H2 以降の ISO でのみ使用できます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "2011 인증서를 폐기한 PC에서 Secure Boot를 켠 채로 부팅할 때 필요합니다. Windows 11 25H2 이상 ISO에서만 쓸 수 있습니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Necessário para inicializar com o Secure Boot ativado em PCs que revogaram o certificado de 2011. Somente para ISOs do Windows 11 25H2 ou posterior." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нужно для загрузки с включенной Secure Boot на ПК, где отозван сертификат 2011 года. Только для ISO Windows 11 25H2 или новее." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在已吊销 2011 证书的 PC 上开启 Secure Boot 启动时需要此项。仅适用于 Windows 11 25H2 或更高版本的 ISO。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在已撤銷 2011 憑證的 PC 上開啟 Secure Boot 開機時需要此項目。僅適用於 Windows 11 25H2 或以上版本的 ISO。" } }
      }
