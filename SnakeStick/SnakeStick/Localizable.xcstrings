    "The stick cannot be booted now." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Stick ist jetzt nicht startfähig." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ahora la memoria USB no puede arrancar." } },
