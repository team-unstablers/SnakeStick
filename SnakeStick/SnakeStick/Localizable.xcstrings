    "Its source code was used as a reference" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Quellcode wurde als Referenz verwendet" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Son code source a servi de référence" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ソースコードを参考にしました" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "소스 코드를 참고했습니다" } },
