    "If you stop now, “%@” will be left unbootable. To use it, you have to start over." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wenn du jetzt stoppst, ist „%@“ nicht mehr startfähig. Um den Stick zu verwenden, musst du von vorn beginnen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Si te detienes ahora, “%@” no podrá arrancar. Para usarla, tendrás que empezar de nuevo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Si vous arrêtez maintenant, « %@ » ne pourra plus démarrer. Pour l’utiliser, vous devrez tout recommencer." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "いま中止すると、「%@」は起動できない状態のまま残ります。使用するには最初からやり直す必要があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지금 중단하면 “%@”은 부팅할 수 없는 상태로 남습니다. 다시 쓰려면 처음부터 시작해야 합니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Se você parar agora, “%@” ficará impossibilitado de inicializar. Para usá-lo, será preciso começar de novo." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Если остановить запись сейчас, с «%@» нельзя будет загрузиться. Чтобы использовать его, придется начать заново." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "如果现在停止，“%@”将无法启动。要使用它，必须从头重新开始。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "若現在停止，「%@」將無法開機。若要使用，必須從頭開始。" } }
      }
    },
