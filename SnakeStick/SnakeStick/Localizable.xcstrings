      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "USB メモリは変更されていません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "스틱은 바뀌지 않았습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "U 盘未被更改。" } }
      }
    },
    "The target disk cannot be written: it is gone, internal, or the startup disk." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "書き込み先ディスクに書き込めません。取り外されたか、内蔵ディスクまたは起動ディスクです。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "대상 디스크에 쓸 수 없습니다. 분리되었거나 내장 디스크 또는 시동 디스크입니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法写入目标磁盘：它已被移除，或者是内置磁盘或启动磁盘。" } }
      }
    },
    "The target disk does not have enough space for this ISO." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "書き込み先ディスクの容量がこの ISO には足りません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "대상 디스크의 공간이 이 ISO에 비해 부족합니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "目标磁盘空间不足以容纳此 ISO。" } }
      }
    },
    "The volume label cannot be used on NTFS: at most 32 characters, none of \"*/:<>?\\|, and no space or dot at the end." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このボリュームラベルは NTFS では使用できません。32 文字以内で、\"*/:<>?\\| を含まず、末尾がスペースやピリオドでない必要があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 볼륨 레이블은 NTFS에서 쓸 수 없습니다. 32자 이하여야 하고, \"*/:<>?\\|를 포함할 수 없으며, 공백이나 마침표로 끝날 수 없습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此卷标不能用于 NTFS：最多 32 个字符，不能包含 \"*/:<>?\\|，且不能以空格或句点结尾。" } }
      }
    },
    "This is not a Windows installation ISO." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Windows インストール ISO ではありません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Windows 설치 ISO가 아닙니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这不是 Windows 安装 ISO。" } }
      }
    },
