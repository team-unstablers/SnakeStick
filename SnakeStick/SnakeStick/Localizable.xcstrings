    "The connection to the helper was lost." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Verbindung zum Hilfsprogramm wurde unterbrochen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se ha perdido la conexión con la herramienta auxiliar." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La connexion à l’outil d’assistance a été perdue." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ヘルパーとの接続が切断されました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "도우미와의 연결이 끊어졌습니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A conexão com a ferramenta auxiliar foi perdida." } },
