    "Erase and Write" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "消去して書き込む" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지우고 쓰기" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "抹掉并写入" } }
      }
    },
    "Erase “%@”?" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」を消去しますか？" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%@”을 지울까요?" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要抹掉“%@”吗？" } }
      }
    },
    "External Disks" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "外部ディスク" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "외장 디스크" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "外置磁盘" } }
      }
    },
    "Failed at step %lld/8: %@" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ステップ %lld/8 で失敗しました: %@" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "단계 %lld/8에서 실패했습니다: %@" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在第 %lld/8 步失败：%@" } }
      }
    },
    "Finished" : {
      "localizations" : {
