    "The ISO cannot be used: it is not a Windows installation ISO, or it lacks what the chosen options need." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die ISO kann nicht verwendet werden: Sie ist keine Windows-Installations-ISO, oder ihr fehlt, was die gewählten Optionen benötigen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se puede usar la ISO: no es una ISO de instalación de Windows o le falta lo que necesitan las opciones elegidas." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible d’utiliser cette ISO : ce n’est pas une ISO d’installation de Windows, ou il lui manque ce dont les options choisies ont besoin." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この ISO は使用できません。Windows インストール ISO ではないか、選択したオプションに必要なファイルがありません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 ISO를 쓸 수 없습니다. Windows 설치 ISO가 아니거나 고른 옵션에 필요한 파일이 없습니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não é possível usar a ISO: ela não é uma ISO de instalação do Windows ou não contém o que as opções escolhidas exigem." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Этот ISO нельзя использовать: это не установочный ISO Windows или в нем нет того, что требуется для выбранных параметров." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法使用此 ISO：它不是 Windows 安装 ISO，或缺少所选选项需要的文件。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法使用此 ISO：它不是 Windows 安裝 ISO，或缺少所選選項需要的檔案。" } }
      }
    },
    "The ISO file cannot be read." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die ISO-Datei kann nicht gelesen werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se puede leer el archivo ISO." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible de lire le fichier ISO." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ISO ファイルを読み込めません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "ISO 파일을 읽을 수 없습니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não é possível ler o arquivo ISO." } },
