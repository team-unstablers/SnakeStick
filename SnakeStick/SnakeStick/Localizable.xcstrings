        "ko" : { "stringUnit" : { "state" : "translated", "value" : "완료" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完成" } }
      }
    },
    "Eject" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "取り出す" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "추출" } },
