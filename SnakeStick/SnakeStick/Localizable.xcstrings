        "ja" : { "stringUnit" : { "state" : "translated", "value" : "USB メモリは変更されていません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "스틱은 바뀌지 않았습니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O pendrive não foi alterado." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Накопитель не был изменен." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "U 盘未被更改。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "隨身碟未被更動。" } }
      }
    },
    "The target disk cannot be written: it is gone, internal, or the startup disk." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Auf das Ziellaufwerk kann nicht geschrieben werden: Es wurde entfernt, ist intern oder ist das Startvolume." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se puede escribir en el disco de destino: se ha retirado, es interno o es el disco de arranque." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible d’écrire sur le disque de destination : il a été retiré, ou c’est un disque interne ou le disque de démarrage." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "書き込み先ディスクに書き込めません。取り外されたか、内蔵ディスクまたは起動ディスクです。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "대상 디스크에 쓸 수 없습니다. 분리되었거나 내장 디스크 또는 시동 디스크입니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não é possível gravar no disco de destino: ele foi removido, é interno ou é o disco de inicialização." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "На целевой диск нельзя записать: он был извлечен, является внутренним или загрузочным диском." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法写入目标磁盘：它已被移除，或者是内置磁盘或启动磁盘。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法寫入目標磁碟：它已被移除，或者是內建磁碟或啟動磁碟。" } }
      }
    },
    "The target disk does not have enough space for this ISO." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Ziellaufwerk hat nicht genug Speicherplatz für diese ISO." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El disco de destino no tiene espacio suficiente para esta ISO." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le disque de destination n’a pas assez d’espace pour cette ISO." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "書き込み先ディスクの容量がこの ISO には足りません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "대상 디스크의 공간이 이 ISO에 비해 부족합니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O disco de destino não tem espaço suficiente para esta ISO." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "На целевом диске недостаточно места для этого ISO." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "目标磁盘空间不足以容纳此 ISO。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目標磁碟的空間不足以容納此 ISO。" } }
      }
    },
    "The volume label cannot be used on NTFS: at most 32 characters, none of \"*/:<>?\\|, and no space or dot at the end." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieser Volumename kann für NTFS nicht verwendet werden: höchstens 32 Zeichen, keines von \"*/:<>?\\| und kein Leerzeichen oder Punkt am Ende." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Este nombre de volumen no se puede usar en NTFS: debe tener 32 caracteres como máximo, no puede contener \"*/:<>?\\| y no puede terminar en espacio ni en punto." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ce nom de volume ne peut pas être utilisé en NTFS : 32 caractères au maximum, aucun des caractères \"*/:<>?\\|, et pas d’espace ni de point à la fin." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このボリュームラベルは NTFS では使用できません。32 文字以内で、\"*/:<>?\\| を含まず、末尾がスペースやピリオドでない必要があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 볼륨 레이블은 NTFS에서 쓸 수 없습니다. 32자 이하여야 하고, \"*/:<>?\\|를 포함할 수 없으며, 공백이나 마침표로 끝날 수 없습니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Este nome de volume não pode ser usado em NTFS: no máximo 32 caracteres, nenhum destes caracteres \"*/:<>?\\| e sem espaço ou ponto no final." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Эту метку тома нельзя использовать в NTFS: не более 32 символов, без символов \"*/:<>?\\| и без пробела или точки в конце." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此卷标不能用于 NTFS：最多 32 个字符，不能包含 \"*/:<>?\\|，且不能以空格或句点结尾。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此卷宗標籤無法用於 NTFS：最多 32 個字元，不可包含 \"*/:<>?\\|，且結尾不可為空格或句點。" } }
      }
    },
    "This is not a Windows installation ISO." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dies ist keine Windows-Installations-ISO." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No es una ISO de instalación de Windows." } },
