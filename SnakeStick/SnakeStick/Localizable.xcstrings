    "Checking the partitions" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Partitionen werden geprüft" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Comprobando las particiones" } },
