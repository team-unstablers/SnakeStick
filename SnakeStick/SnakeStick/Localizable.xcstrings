        "ja" : { "stringUnit" : { "state" : "translated", "value" : "バージョン %@ (%@)" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "버전 %@ (%@)" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Versão %@ (%@)" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Версия %@ (%@)" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "版本 %@ (%@)" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "版本 %@ (%@)" } }
      }
    },
    "After writing, reads the NTFS volume on the stick back and compares it with the ISO's file tree." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Liest nach dem Schreiben das NTFS-Volume auf dem Stick zurück und vergleicht es mit der Dateistruktur der ISO." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tras la escritura, vuelve a leer el volumen NTFS de la memoria USB y lo compara con el árbol de archivos de la ISO." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Après l’écriture, relit le volume NTFS de la clé et le compare à l’arborescence de fichiers de l’ISO." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "書き込み後に USB メモリの NTFS ボリュームを読み戻し、ISO のファイルツリーと比較します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "기록을 마친 뒤 스틱의 NTFS 볼륨을 다시 읽어 ISO의 파일 트리와 비교합니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Após a gravação, lê novamente o volume NTFS do pendrive e o compara com a árvore de arquivos da ISO." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "После записи заново считывает том NTFS с накопителя и сравнивает его с деревом файлов ISO." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "写入完成后，重新读取 U 盘上的 NTFS 宗卷，并与 ISO 的文件树进行比较。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "寫入完成後，重新讀取隨身碟上的 NTFS 卷宗，並與 ISO 的檔案樹狀結構進行比對。" } }
      }
    },
    "All partitions and data on %@(%@) will be erased and it will be made into a Windows installation disk. This cannot be undone. If you continue, you will be asked for an administrator password once." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Alle Partitionen und Daten auf %@(%@) werden gelöscht, und daraus wird ein Windows-Installationsmedium erstellt. Dies kann nicht widerrufen werden. Wenn du fortfährst, wirst du einmal nach einem Administratorpasswort gefragt." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se borrarán todas las particiones y los datos de %@(%@) y se convertirá en un disco de instalación de Windows. Esta acción no se puede deshacer. Si continúas, se te pedirá una vez la contraseña de un administrador." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Toutes les partitions et données de %@(%@) seront effacées et il deviendra un disque d’installation de Windows. Cette opération est irréversible. Si vous continuez, le mot de passe d’un administrateur vous sera demandé une fois." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@(%@) のすべてのパーティションとデータが消去され、Windows インストールディスクに作り直されます。この操作は取り消せません。続けると、管理者パスワードを 1 回入力するよう求められます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@(%@)의 모든 파티션과 데이터가 지워지고 Windows 설치 디스크로 다시 만들어집니다. 되돌릴 수 없습니다. 계속하면 관리자 암호를 한 번 묻습니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Todas as partições e dados de %@(%@) serão apagados, e ele será transformado em um disco de instalação do Windows. Esta ação não pode ser desfeita. Se você continuar, a senha de um administrador será solicitada uma vez." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Все разделы и данные на %@(%@) будут стерты, и он станет установочным диском Windows. Это действие нельзя отменить. Если продолжить, один раз потребуется ввести пароль администратора." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@(%@) 上的所有分区和数据都将被抹掉，并被制作成 Windows 安装盘。此操作无法撤销。如果继续，系统会要求你输入一次管理员密码。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%@(%@) 上的所有分割區和資料都會被清除，並製作成 Windows 安裝磁碟。此動作無法還原。若繼續，系統會要求你輸入一次管理者密碼。" } }
      }
    },
    "Allow Full Disk Access for SnakeStick" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Erlaube SnakeStick den Festplattenvollzugriff" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Permite el acceso total al disco a SnakeStick" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Autorisez l’accès complet au disque pour SnakeStick" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "SnakeStick にフルディスクアクセスを許可してください" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "SnakeStick에 전체 디스크 접근 권한을 허용하세요" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Permita o Acesso Total ao Disco para o SnakeStick" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Предоставьте SnakeStick доступ к диску" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请为 SnakeStick 允许完全磁盘访问权限" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請允許 SnakeStick 完全取用磁碟" } }
      }
    },
    "macOS keeps the helper that writes the disk away from removable disks and your folders until SnakeStick has Full Disk Access. Add SnakeStick in System Settings > Privacy & Security > Full Disk Access, then try again." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Solange SnakeStick keinen Festplattenvollzugriff hat, sperrt macOS das Hilfsprogramm, das auf das Laufwerk schreibt, von Wechselmedien und deinen Ordnern aus. Füge SnakeStick unter Systemeinstellungen > Datenschutz & Sicherheit > Festplattenvollzugriff hinzu und versuche es dann erneut." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Mientras SnakeStick no tenga acceso total al disco, macOS impide que la herramienta auxiliar que escribe en el disco acceda a los discos extraíbles y a tus carpetas. Añade SnakeStick en Ajustes del Sistema > Privacidad y seguridad > Acceso total al disco y vuelve a intentarlo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tant que SnakeStick n’a pas l’accès complet au disque, macOS empêche l’outil d’assistance qui écrit sur le disque d’accéder aux disques amovibles et à vos dossiers. Ajoutez SnakeStick dans Réglages Système > Confidentialité et sécurité > Accès complet au disque, puis réessayez." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "SnakeStick にフルディスクアクセスがないと、ディスクに書き込むヘルパーは macOS によってリムーバブルディスクやユーザのフォルダへのアクセスを禁止されます。システム設定 > プライバシーとセキュリティ > フルディスクアクセスに SnakeStick を追加してから、もう一度お試しください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "SnakeStick에 전체 디스크 접근 권한이 없으면 macOS가 디스크를 쓰는 도우미의 이동식 디스크와 사용자 폴더 접근을 막습니다. 시스템 설정 > 개인정보 보호 및 보안 > 전체 디스크 접근 권한에 SnakeStick을 추가한 뒤 다시 시도하세요." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Enquanto o SnakeStick não tiver Acesso Total ao Disco, o macOS impede que a ferramenta auxiliar que grava o disco acesse discos removíveis e as suas pastas. Adicione o SnakeStick em Ajustes do Sistema > Privacidade e Segurança > Acesso Total ao Disco e tente novamente." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Пока у SnakeStick нет доступа к диску, macOS не допускает вспомогательную программу, которая записывает диск, к съемным дискам и вашим папкам. Добавьте SnakeStick в разделе «Системные настройки» > «Конфиденциальность и безопасность» > «Доступ к диску», затем повторите попытку." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 SnakeStick 获得完全磁盘访问权限之前，macOS 会阻止写入磁盘的辅助程序访问可移除磁盘和你的文件夹。请在系统设置 > 隐私与安全性 > 完全磁盘访问权限中添加 SnakeStick，然后重试。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在 SnakeStick 取得完全取用磁碟權限之前，macOS 會阻止寫入磁碟的輔助程式取用可移除式磁碟和你的資料夾。請在系統設定 > 隱私權與安全性 > 完全取用磁碟中加入 SnakeStick，然後再試一次。" } }
      }
    },
    "Allow the SnakeStick helper" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Erlaube das SnakeStick-Hilfsprogramm" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Permite la herramienta auxiliar de SnakeStick" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Autorisez l’outil d’assistance de SnakeStick" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "SnakeStick のヘルパーを許可してください" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "SnakeStick 도우미를 허용하세요" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Permita a ferramenta auxiliar do SnakeStick" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Разрешите вспомогательную программу SnakeStick" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请允许 SnakeStick 辅助程序" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請允許 SnakeStick 輔助程式" } }
      }
    },
    "An I/O error occurred (%@). The stick may have been removed or damaged." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ein E/A-Fehler ist aufgetreten (%@). Der Stick wurde möglicherweise entfernt oder ist beschädigt." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se ha producido un error de entrada/salida (%@). Es posible que la memoria USB se haya retirado o esté dañada." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Une erreur d’entrée/sortie s’est produite (%@). La clé a peut-être été retirée ou est endommagée." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "入出力エラーが発生しました (%@)。USB メモリが取り外されたか、破損している可能性があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "입출력 오류가 났습니다 (%@). 스틱이 분리되었거나 손상되었을 수 있습니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ocorreu um erro de entrada/saída (%@). O pendrive pode ter sido removido ou estar danificado." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Произошла ошибка ввода-вывода (%@). Возможно, накопитель был извлечен или поврежден." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "发生输入/输出错误 (%@)。U 盘可能已被移除或已损坏。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "發生輸入/輸出錯誤 (%@)。隨身碟可能已被移除或已損壞。" } }
      }
    },
    "An I/O error occurred while writing %@ (%@). The stick may have been removed or damaged." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Beim Schreiben von %@ ist ein E/A-Fehler aufgetreten (%@). Der Stick wurde möglicherweise entfernt oder ist beschädigt." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se ha producido un error de entrada/salida al escribir %@ (%@). Es posible que la memoria USB se haya retirado o esté dañada." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Une erreur d’entrée/sortie s’est produite lors de l’écriture de %@ (%@). La clé a peut-être été retirée ou est endommagée." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ の書き込み中に入出力エラーが発生しました (%@)。USB メモリが取り外されたか、破損している可能性があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@을 쓰는 중 입출력 오류가 났습니다 (%@). 스틱이 분리되었거나 손상되었을 수 있습니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ocorreu um erro de entrada/saída ao gravar %@ (%@). O pendrive pode ter sido removido ou estar danificado." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "При записи %@ произошла ошибка ввода-вывода (%@). Возможно, накопитель был извлечен или поврежден." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "写入 %@ 时发生输入/输出错误 (%@)。U 盘可能已被移除或已损坏。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "寫入 %@ 時發生輸入/輸出錯誤 (%@)。隨身碟可能已被移除或已損壞。" } }
      }
    },
    "An unexpected error occurred. See the log for details." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ein unerwarteter Fehler ist aufgetreten. Details findest du im Protokoll." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se ha producido un error inesperado. Consulta el registro para obtener más información." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Une erreur inattendue s’est produite. Consultez le journal pour en savoir plus." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "予期しないエラーが発生しました。詳しくはログを参照してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "예상하지 못한 오류가 났습니다. 자세한 내용은 로그를 보세요." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ocorreu um erro inesperado. Consulte o registro para obter detalhes." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Произошла непредвиденная ошибка. Подробности см. в журнале." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "发生意外错误。有关详细信息，请查看日志。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "發生未預期的錯誤。如需詳細資訊，請查看記錄。" } }
      }
    },
    "Available once you choose a Windows 11 25H2 or later ISO." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Verfügbar, sobald du eine ISO von Windows 11 25H2 oder neuer auswählst." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Disponible cuando eliges una ISO de Windows 11 25H2 o posterior." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Disponible après avoir choisi une ISO de Windows 11 25H2 ou ultérieure." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Windows 11 25H2 以降の ISO を選ぶと使用できます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Windows 11 25H2 이상 ISO를 고르면 쓸 수 있습니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Disponível quando você escolher uma ISO do Windows 11 25H2 ou posterior." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Доступно после выбора ISO Windows 11 25H2 или новее." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择 Windows 11 25H2 或更高版本的 ISO 后可用。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇 Windows 11 25H2 或以上版本的 ISO 後即可使用。" } }
      }
    },
